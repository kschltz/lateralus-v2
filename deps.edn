{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        integrant/integrant {:mvn/version "0.13.1"}
        metosin/malli {:mvn/version "0.16.4"}
        hato/hato {:mvn/version "1.0.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        rewrite-clj/rewrite-clj {:mvn/version "1.2.54"}
        ;; Hickory HTML parser, used by the `:mojeek` AND `:ddg` live web
        ;; providers (both parse result-page HTML). JVM-only — kept out
        ;; of the `:native` `:replace-deps` below so GraalVM builds stay
        ;; air-gapped under the `:none` default.
        org.clj-commons/hickory {:mvn/version "0.7.7"}
        ;; impersonator (BouncyCastle-bctls + forked OkHttp) spoofs a browser
        ;; TLS/JA3/JA4 + HTTP/2 fingerprint so DuckDuckGo's HTML endpoint
        ;; returns real results instead of a degraded/CAPTCHA page. Used by
        ;; the `:ddg` provider. JVM-only — NOT in `:native :replace-deps`
        ;; (native builds exclude it like hickory/proximum).
        com.github.zhkl0228/impersonator-okhttp {:mvn/version "1.0.12"}
        ;; Proximum is optional: it is only loaded when
        ;; :lateralus/memory-backend {:impl :proximum ...} is configured.
        ;; It requires Java 22+ and the incubator Vector/FFM JVM flags.
        org.replikativ/proximum {:mvn/version "0.1.25"}
        ;; LangChain4j in-process ONNX embedding model. The jar bundles the
        ;; all-MiniLM-L6-v2 weights, so no network calls are made at runtime.
        ;; Native-image users should switch to an HTTP embedder instead.
        dev.langchain4j/langchain4j-embeddings-all-minilm-l6-v2 {:mvn/version "0.36.2"}}
 ;; No Datalevin in MVP — session memory is a noop impl of the
 ;; MemoryBackend protocol. A real persistent store is a follow-up.
 :aliases
 {:run {:main-opts ["-m" "kschltz.lateralus"]}
  :build {:deps {io.github.clojure/tools.build
                  {:mvn/version "0.10.13"}}
           :ns-default build}
  :dev {:extra-paths ["dev"]
        ;; Dev scripts may exercise Proximum / LangChain4j, so keep
        ;; the incubator module flags available.
        :jvm-opts ["--add-modules=jdk.incubator.vector"
                   "--enable-native-access=ALL-UNNAMED"]}
  ;; Native-image alias: builds a native executable that excludes the
  ;; JVM-only Proximum HNSW index and the LangChain4j ONNX embedder.
  ;; Only the KG + BM25 memory backend (and optionally the HTTP embedder)
  ;; is available in this profile.
  :native {:replace-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                          org.clojure/tools.cli {:mvn/version "1.1.230"}
                          integrant/integrant {:mvn/version "0.13.1"}
                          metosin/malli {:mvn/version "0.16.4"}
                          hato/hato {:mvn/version "1.0.0"}
                          cheshire/cheshire {:mvn/version "6.2.0"}
                          rewrite-clj/rewrite-clj {:mvn/version "1.2.54"}
                          io.github.clojure/tools.build {:mvn/version "0.10.13"}
                          com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}}
           ;; Direct-linking improves native-image size and startup.
           ;; The build task also enables *warn-on-reflection* during compilation.
           :jvm-opts ["-Dclojure.compiler.direct-linking=true"]
           :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; Test-only HTTP server for LLM end-to-end tests.
                      ;; Not on the production classpath; the runtime
                      ;; build doesn't need it.
                      ring/ring-core {:mvn/version "1.13.0"}
                      ring/ring-jetty-adapter {:mvn/version "1.13.0"}}
         ;; Proximum + LangChain4j tests need the Vector API, FFM, and
         ;; ONNX tokenizer native extraction.
         :jvm-opts ["--add-modules=jdk.incubator.vector"
                    "--enable-native-access=ALL-UNNAMED"]
         ;; Exclude ^:e2e tests from the default fast suite.
         :main-opts ["-m" "cognitect.test-runner" "-e" ":e2e"]}
  ;; Run only the ^:e2e tests. This requires a local Ollama instance
  ;; (default model glm5.1:cloud) or LATERALUS_E2E_FAKE=true.
  :e2e {:extra-paths ["test"]
        :extra-deps {io.github.cognitect-labs/test-runner
                     {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                     ring/ring-core {:mvn/version "1.13.0"}
                     ring/ring-jetty-adapter {:mvn/version "1.13.0"}}
        :jvm-opts ["--add-modules=jdk.incubator.vector"
                   "--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "cognitect.test-runner" "-i" ":e2e"]}
  :examples {:extra-paths []}}}
