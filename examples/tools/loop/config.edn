;; Tool-calling loop example for lateralus-v2.
;;
;; This config uses the core tool-calling loop that is now part of the
;; default base chain. It registers the two example tools (`time/now` and
;; `calculator/eval`) via `:lateralus/example-tools` and seeds the registry
;; with `:lateralus/tools-plugin`.
;;
;; Requirements:
;;   - Ollama running and accessible at the base URL below.
;;   - A model that supports tool calling (e.g. deepseek-v4-flash:cloud,
;;     llama3.1, mistral-nemo, etc.).
;;
;; Run (from the repo root):
;;   clojure -M:examples -m kschltz.lateralus --config examples/tools/loop/config.edn -i
;;
;; The example registers two tools:
;;   - time/now        — returns current UTC ISO-8601 time
;;   - calculator/eval — evaluates simple prefix arithmetic, e.g. "(+ 1 2 3)"

{:lateralus/llm-client     {:impl :http
                             :base-url "http://localhost:11434/v1"
                             :model    "deepseek-v4-flash:cloud"}
 :lateralus/llm-config     {:base-url "http://localhost:11434/v1"
                            :model    "deepseek-v4-flash:cloud"}
 :lateralus/embedder       {:method :noop}
 :lateralus/memory-backend {:impl :noop}
 :lateralus/example-tools  {}
 :lateralus/tool-registry  #ig/ref :lateralus/example-tools
 :lateralus/tools-plugin   {:registry #ig/ref :lateralus/tool-registry}
 :lateralus/plugins        [#ig/ref :lateralus/tools-plugin]
 :lateralus/agent          {:plugins        #ig/ref :lateralus/plugins
                            :llm-client     #ig/ref :lateralus/llm-client
                            :llm-config     #ig/ref :lateralus/llm-config
                            :embedder       #ig/ref :lateralus/embedder
                            :memory-backend #ig/ref :lateralus/memory-backend}}
