;; Integrant system config — mirrors kschltz.agent.system/default-config.
;; Loaded automatically when present on the classpath; override any key here
;; to change runtime behavior without editing code, or pass --config PATH.
;;
;; Examples:
;;   :lateralus/llm-client     {:impl :http :base-url "..." :api-key "..." :model "gpt-4"}
;;   :lateralus/memory-backend   {:impl :noop}
;;   :lateralus/plugins          {:plugins [...]}

{:lateralus/llm-client     {:impl :stub}
 :lateralus/llm-config     {}
 :lateralus/embedder       {:method :noop}
 ;; The memory backend receives the resolved embedder so it can embed
 ;; message content at store time. Use :impl :proximum for a durable
 ;; HNSW backend (requires Java 22+ and Vector/FFM JVM flags).
 :lateralus/memory-backend {:impl :noop
                            :embedder #ig/ref :lateralus/embedder}
 :lateralus/base-plugin    {}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/plugins        {:plugins [#ig/ref :lateralus/memory-plugin]}
 :lateralus/agent          {:plugins        #ig/ref :lateralus/plugins
                            :llm-client     #ig/ref :lateralus/llm-client
                            :llm-config     #ig/ref :lateralus/llm-config
                            :embedder       #ig/ref :lateralus/embedder
                            :memory-backend #ig/ref :lateralus/memory-backend}}
