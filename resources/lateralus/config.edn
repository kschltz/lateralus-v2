;; Runtime default Integrant config for lateralus-v2.
;; Loaded automatically from the classpath; override any key here,
;; or pass --config PATH to merge a custom EDN file over this one.
;;
;; Runtime default: stub LLM + LangChain4j in-process ONNX embedder +
;; Proximum in-memory HNSW memory backend.
;;
;; Requirements for this default:
;;   - Java 22+
;;   - JVM flags for Proximum/LangChain4j (Vector API + FFM) are baked
;;     into the :run / :workbench / :test aliases in deps.edn — just use
;;     `clojure -M:run` (or the uberjar launcher).
;;
;; Override examples:
;;   :lateralus/llm-client     {:impl :http :base-url "..." :api-key "..." :model "gpt-4"}
;;   :lateralus/memory-backend   {:impl :proximum
;;                               :store {:backend :file
;;                                       :path "sessions/proximum"
;;                                       :id #uuid "465df026-fcd3-4cb3-be44-29a929776250"}}
;;   :lateralus/plugins          [#ig/ref :lateralus/memory-plugin
;;                                #ig/ref :lateralus/tools-plugin]

{:lateralus/llm-client     {:impl :stub}
 :lateralus/llm-config     {}
 :lateralus/embedder       {:method :langchain4j}
 ;; In-memory Proximum backend. Set :store for file persistence.
 :lateralus/memory-backend {:impl :proximum
                            :embedder #ig/ref :lateralus/embedder}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/file-tools           {}
 :lateralus/self-awareness-tools {}
 :lateralus/clojure-tools        {}
 ;; Session LLM config tools (set_llm_config, list_llm_models). Transitions
 ;; are harvested/applied in the base :tools slot; :catalog :http lists
 ;; models via the OpenAI-compatible endpoint.
 :lateralus/config-tools         {:catalog :http}
 ;; Runtime-eval tools (clojure_eval, clojure_add_lib, clojure_loaded_libs):
 ;; run Clojure in-process and load Maven deps at runtime (Clojure 1.12
 ;; add-libs). Arbitrary code execution — set :enabled? false to disable,
 ;; or :network? false to keep eval but block runtime dependency loading.
 :lateralus/runtime-tools        {:enabled? true :network? true}
 ;; Web tools: :none by default (air-gapped). Switch to :mojeek for live search.
 :lateralus/web-tools      {:provider :none}
 ;; MCP client tools: empty by default (air-gapped, no child processes).
 ;; Opt in with Claude Desktop-like server stanzas, e.g.
 ;;   {:servers {"filesystem" {:command "npx"
 ;;                            :args ["-y" "@modelcontextprotocol/server-filesystem" "/tmp/sandbox"]}}}
 ;; Open Design: see resources/lateralus/open-design-mcp.edn
 :lateralus/mcp-tools
 {:servers {}
  :dynamic {:enabled? false}}
 :lateralus/mcp-session-tools    {:session #ig/ref :lateralus/mcp-tools}
 :lateralus/logging             {}
 :lateralus/cli-ui              {:enabled? :auto :theme :default}
 :lateralus/thinking            {:mode :preview}
 :lateralus/loop-opts            {:max-tool-calls-per-turn 100 :max-tool-calls-per-exchange 20 :tool-content-caps {"clojure_eval" 12000 "clojure_add_lib" 12000}}
 :lateralus/tool-registry        [#ig/ref :lateralus/file-tools
                                  #ig/ref :lateralus/self-awareness-tools
                                  #ig/ref :lateralus/config-tools
                                  #ig/ref :lateralus/clojure-tools
                                  #ig/ref :lateralus/runtime-tools
                                  #ig/ref :lateralus/web-tools
                                  #ig/ref :lateralus/mcp-session-tools]
 :lateralus/tools-plugin         {:registry #ig/ref :lateralus/tool-registry
                                  :mcp-session #ig/ref :lateralus/mcp-tools}
 :lateralus/plugins              [#ig/ref :lateralus/memory-plugin
                                  #ig/ref :lateralus/tools-plugin]
 :lateralus/agent                {:plugins        #ig/ref :lateralus/plugins
                                  :llm-client     #ig/ref :lateralus/llm-client
                                  :llm-config     #ig/ref :lateralus/llm-config
                                  :embedder       #ig/ref :lateralus/embedder
                                  :memory-backend #ig/ref :lateralus/memory-backend
                                  :cli-ui         #ig/ref :lateralus/cli-ui
                                  :thinking       #ig/ref :lateralus/thinking
                                 :loop-opts        #ig/ref :lateralus/loop-opts}}
