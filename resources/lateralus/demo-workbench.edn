;; Interactive local Ollama + CHAT | Portal workbench plugin.
;; Requires the :workbench deps alias (portal + http-kit; JVM flags baked in):
;;   clojure -M:workbench:run -i --config resources/lateralus/demo-workbench.edn \
;;     --base-url http://localhost:11434/v1 --model laguna-s-2.1:latest
;; Or omit --config and use the profile gate:
;;   clojure -M:workbench:run -i
{:lateralus/llm-client     {:impl :http
                            :base-url "http://localhost:11434/v1"}
 :lateralus/llm-config     {:base-url "http://localhost:11434/v1"}
 :lateralus/embedder       {:method :noop}
 :lateralus/memory-backend {:impl :kg-bm25
                            :store {:backend :memory}}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/file-tools           {}
 :lateralus/self-awareness-tools {}
 :lateralus/clojure-tools        {}
 :lateralus/logging             {}
 :lateralus/cli-ui              {:enabled? :auto :theme :default}
 :lateralus/thinking            {:mode :preview}
 :lateralus/workbench           {:enabled? true
                                 :stream-bus #ig/ref :lateralus/stream-bus
                                 :host "127.0.0.1"
                                 :port 7860
                                 :portal? true
                                 :open-browser? false
                                 :app false
                                 :window-title "lateralus"}
 ;; Secrets store + UI management: opt-in. Requires the
 ;; LATERALUS_SECRETS_PASSPHRASE env var (manage from the workbench UI
 ;; via Settings → Secrets, or a REPL via kschltz.agent.secrets).
 ;; :lateralus/secret-store  {:path ".lateralus/secrets.sealed"
 ;;                           :passphrase-env "LATERALUS_SECRETS_PASSPHRASE"}
 ;; :lateralus/secret-plugin {:store #ig/ref :lateralus/secret-store}
 ;; …then add :secret-store #ig/ref :lateralus/secret-store to
 ;; :lateralus/workbench below (and add the tool redaction sweep by
 ;; listing :lateralus/secret-plugin AFTER :lateralus/tools-plugin in
 ;; :lateralus/plugins).
 :lateralus/workbench-plugin    {:workbench #ig/ref :lateralus/workbench}
 :lateralus/workbench-tools     {:workbench #ig/ref :lateralus/workbench}
 :lateralus/web-tools      {:provider :ddg}
 :lateralus/runtime-tools        {:enabled? true :network? true}
 :lateralus/loop-opts            {:max-tool-calls-per-turn 100
                                  :max-tool-calls-per-exchange 20
                                  :tool-content-caps {"clojure_eval" 12000
                                                      "clojure_add_lib" 12000}}
 ;; Open Design MCP tools (stdio proxy to local daemon).
 ;; Start the daemon first; override defaults via OD_DAEMON_URL/OD_BIN/OD_NODE.
 :lateralus/mcp-tools
 {:servers
  {"open-design"
   {:transport :stdio
    :command "/Users/schltzk/projects/lateralus-v2/scripts/open-design-mcp-server.sh"
    :args []
    :startup-timeout-ms 30000
    :request-timeout-ms 30000
    :max-result-bytes 2097152}}
  :dynamic {:enabled? true}}
 :lateralus/mcp-session-tools    {:session #ig/ref :lateralus/mcp-tools}
 :lateralus/factory-session      {:workspace-root "." :dynamic {:enabled? true}}
 :lateralus/factory-tools        {:session #ig/ref :lateralus/factory-session}
 :lateralus/factory-plugin       {:session #ig/ref :lateralus/factory-session}
 :lateralus/workflow-tools       {}
 :lateralus/tool-registry        [#ig/ref :lateralus/file-tools
                                  #ig/ref :lateralus/self-awareness-tools
                                  #ig/ref :lateralus/clojure-tools
                                  #ig/ref :lateralus/web-tools
                                  #ig/ref :lateralus/runtime-tools
                                  #ig/ref :lateralus/workbench-tools
                                  #ig/ref :lateralus/mcp-session-tools
                                  #ig/ref :lateralus/factory-tools
                                  #ig/ref :lateralus/workflow-tools]
 :lateralus/tools-plugin         {:registry #ig/ref :lateralus/tool-registry
                                  :mcp-session #ig/ref :lateralus/mcp-tools
                                  :factory-session #ig/ref :lateralus/factory-session}
 :lateralus/stream-bus           {}
 :lateralus/stream-plugin        {:bus #ig/ref :lateralus/stream-bus}
 :lateralus/plugins              [#ig/ref :lateralus/memory-plugin
                                  #ig/ref :lateralus/tools-plugin
                                  #ig/ref :lateralus/factory-plugin
                                  #ig/ref :lateralus/workbench-plugin
                                  #ig/ref :lateralus/stream-plugin]
 :lateralus/agent                {:plugins        #ig/ref :lateralus/plugins
                                  :llm-client     #ig/ref :lateralus/llm-client
                                  :llm-config     #ig/ref :lateralus/llm-config
                                  :embedder       #ig/ref :lateralus/embedder
                                  :memory-backend #ig/ref :lateralus/memory-backend
                                  :logging        #ig/ref :lateralus/logging
                                  :cli-ui         #ig/ref :lateralus/cli-ui
                                  :thinking       #ig/ref :lateralus/thinking
                                  :workbench      #ig/ref :lateralus/workbench
                                  :loop-opts      #ig/ref :lateralus/loop-opts}}
