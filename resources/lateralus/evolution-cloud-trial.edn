{:proposal
 {:id "cloud-unused-require"
  :title "Remove one verified unused CLI require"
  :objective "Remove [kschltz.agent.tool :as tool] from the CLI namespace"
  :evidence ["clj-kondo reports kschltz.agent.tool as an unused namespace"]
  :acceptance ["The exact unused require is absent and the CLI namespace loads"]
  :paths ["src/kschltz/agent/cli.clj"]
  :risk :low
  :source :board}

 :default-gates {:lint? false :fast-tests? false}

 :policy
 {:max-run-wall-ms 600000
  :max-implement-wall-ms 300000
  :max-candidates 1
  :max-agent-turns 5
  :max-tool-calls 30
  :max-token-usage 50000
  :max-changed-files 1
  :max-output-bytes 262144
  :allowed-paths ["src/kschltz/agent/cli.clj"]
  :protected-paths [".git/" ".kanban/" ".lateralus/" "test/"
                    "deps.edn" "build.clj" "AGENT_INSTRUCTIONS.md"
                    "src/kschltz/agent/evolution/"
                    "resources/lateralus/config.edn"]
  :require-network-isolation? true
  :require-workspace-isolation? true}

 :gates
 [{:id "cli-loads"
   :kind :regression
   :argv ["java" "--add-modules=jdk.incubator.vector"
          "--enable-native-access=ALL-UNNAMED"
          "-cp" "{{workspace-classpath}}"
          "clojure.main" "-e" "(require 'kschltz.agent.cli)"]
   :timeout-ms 120000
   :network :deny
   :required? true}
  {:id "unused-require-removed"
   :kind :acceptance
   :argv ["java" "-cp" "{{workspace-classpath}}"
          "clojure.main" "-e"
          "(require '[clojure.string :as str]) (System/exit (if (str/includes? (slurp \"src/kschltz/agent/cli.clj\") \"[kschltz.agent.tool :as tool]\") 1 0))"]
   :timeout-ms 30000
   :network :deny
   :required? true}]}
