;; Native-image runtime config for lateralus-v2.
;;
;; This config avoids the JVM-only Proximum HNSW index and the LangChain4j
;; in-process ONNX embedder, both of which are excluded from the native
;; classpath. It uses the stub LLM, the noop embedder, and the pure-Clojure
;; KG + BM25 memory backend.
;;
;; For a live Ollama demo with the native binary, override the LLM client via
;; --config resources/lateralus/demo-ollama.edn or a custom config.
;;
;; Build and run:
;;   export GRAALVM_HOME=/path/to/graalvm
;;   clojure -T:native native
;;   ./target/lateralus-v2-native --config resources/lateralus/native.edn "hello"
{:lateralus/llm-client     {:impl :stub}
 :lateralus/llm-config     {}
 :lateralus/embedder       {:method :noop}
 :lateralus/memory-backend {:impl :kg-bm25
                            :store {:backend :memory}}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/file-tools           {}
 :lateralus/self-awareness-tools {}
 :lateralus/clojure-tools        {}
 ;; Native-image never includes Hickory, so web tools must stay :none.
 :lateralus/web-tools      {:provider :none}
 :lateralus/runtime-tools        {:enabled? true :network? false}  ;; native: eval works; add-lib disabled (tools.deps not on native classpath)
 :lateralus/loop-opts            {:max-tool-calls-per-turn 100}
 :lateralus/tool-registry        [#ig/ref :lateralus/file-tools
                                  #ig/ref :lateralus/self-awareness-tools
                                  #ig/ref :lateralus/clojure-tools
                                  #ig/ref :lateralus/web-tools
                                  #ig/ref :lateralus/runtime-tools]
 :lateralus/tools-plugin         {:registry #ig/ref :lateralus/tool-registry}
 :lateralus/plugins              [#ig/ref :lateralus/memory-plugin
                                  #ig/ref :lateralus/tools-plugin]
 :lateralus/agent                {:plugins        #ig/ref :lateralus/plugins
                                  :llm-client     #ig/ref :lateralus/llm-client
                                  :llm-config     #ig/ref :lateralus/llm-config
                                  :embedder       #ig/ref :lateralus/embedder
                                  :memory-backend #ig/ref :lateralus/memory-backend
                                  :loop-opts        #ig/ref :lateralus/loop-opts}}
