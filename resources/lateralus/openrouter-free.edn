;; OpenRouter "free" models config for lateralus-v2.
;;
;; Runs the agent against https://openrouter.ai/api/v1 using any of the
;; `:free`-suffixed models. No Ollama, no local model, no Java 22
;; incubator flags required — uses the lightweight KG+BM25 memory backend
;; with a noop embedder, so it boots anywhere `clojure` + Java 22 run.
;;
;; Usage (key from env, never written into the config):
;;   OPENROUTER_API_KEY=sk-or-v1-... \
;;     clojure -M:run \
;;       --config resources/lateralus/openrouter-free.edn \
;;       --api-key "$OPENROUTER_API_KEY" \
;;       "Hello from a Sprite"
;;
;; Pick a different free model with --model, or leave :model blank to
;; hit the interactive model picker (GETs /v1/models from OpenRouter).
;;
;; Default — best capability/latency balance for a tool-calling agent loop:
;; NOTE: model ids are OpenRouter's `provider/model` form (no `openrouter/` prefix).
;;
;;   nvidia/nemotron-3-super-120b-a12b:free   (256K, 12B-active MoE, reasoning) — DEFAULT
;;
;; Other verified tool-capable :free models (all support tools + tool_choice):
;;   nvidia/nemotron-3-ultra-550b-a55b:free   (1M ctx, 55B-active — most capable, throttled on free tier)
;;   poolside/laguna-m.1:free                  (256K, coding-specialized, reasoning)
;;   poolside/laguna-s-2.1:free               (256K, reasoning)
;;   cohere/north-mini-code:free              (256K, code-focused)
;;   inclusionai/ling-3.0-flash:free          (262K, reasoning, fast)
;;   google/gemma-4-31b-it:free               (262K, multimodal, no reasoning)
;;   google/gemma-4-26b-a4b-it:free           (262K, multimodal, no reasoning)
;;   nvidia/nemotron-3-nano-30b-a3b:free      (256K, smaller)
;;   openai/gpt-oss-20b:free                  (131K, no reasoning)
;;
;; Caveat: free models frequently ignore tool_choice / drop tool calls;
;; if the agent stalls on empty assistant turns, switch models with --model.

{:lateralus/llm-client     {:impl    :http
                            :base-url "https://openrouter.ai/api/v1"
                            :model    "nvidia/nemotron-3-super-120b-a12b:free"}
 :lateralus/llm-config     {:base-url "https://openrouter.ai/api/v1"
                            :model    "nvidia/nemotron-3-super-120b-a12b:free"}
 :lateralus/embedder       {:method :noop}
 :lateralus/memory-backend {:impl :kg-bm25
                            :store {:backend :memory}}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/file-tools           {}
 :lateralus/self-awareness-tools {}
 :lateralus/clojure-tools        {}
 :lateralus/logging             {}
 :lateralus/web-tools      {:provider :none}
 :lateralus/runtime-tools        {:enabled? true :network? true}
 :lateralus/cli-ui              {:enabled? :auto :theme :default}
 :lateralus/thinking            {:mode :preview}
 :lateralus/loop-opts            {:max-tool-calls-per-turn 100 :max-tool-calls-per-exchange 20 :tool-content-caps {"clojure_eval" 12000 "clojure_add_lib" 12000}}
 :lateralus/tool-registry        [#ig/ref :lateralus/file-tools
                                  #ig/ref :lateralus/self-awareness-tools
                                  #ig/ref :lateralus/clojure-tools
                                  #ig/ref :lateralus/web-tools
                                  #ig/ref :lateralus/runtime-tools]
 :lateralus/tools-plugin         {:registry #ig/ref :lateralus/tool-registry}
 :lateralus/plugins              [#ig/ref :lateralus/memory-plugin
                                  #ig/ref :lateralus/tools-plugin]
 :lateralus/agent                {:plugins        #ig/ref :lateralus/plugins
                                  :llm-client     #ig/ref :lateralus/llm-client
                                  :llm-config     #ig/ref :lateralus/llm-config
                                  :embedder       #ig/ref :lateralus/embedder
                                  :memory-backend #ig/ref :lateralus/memory-backend
                                  :cli-ui         #ig/ref :lateralus/cli-ui
                                  :thinking       #ig/ref :lateralus/thinking
                                  :loop-opts       #ig/ref :lateralus/loop-opts}}