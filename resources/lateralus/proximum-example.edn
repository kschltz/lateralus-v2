;; Example Integrant config: real HTTP LLM + Proximum file-backed memory +
;; LangChain4j in-process ONNX embedder.
;; Copy/adapt this file and pass it with --config PATH.
;;
;; Requirements:
;;   - Java 22+
;;   - JVM flags: --add-modules=jdk.incubator.vector
;;                --enable-native-access=ALL-UNNAMED
;;     (already included in the ./target/lateralus-v2 launcher;
;;      pass them manually when running via clojure -M:run)

{:lateralus/llm-client     {:impl :http
                            :base-url "https://api.openai.com/v1"
                            :api-key  "sk-..."
                            :model    "gpt-4o-mini"}
 :lateralus/llm-config     {:base-url "https://api.openai.com/v1"
                            :api-key  "sk-..."
                            :model    "gpt-4o-mini"}
 :lateralus/embedder       {:method :langchain4j}
 :lateralus/memory-backend {:impl :proximum
                            :embedder #ig/ref :lateralus/embedder
                            ;; File persistence: keep this id stable across restarts
                            ;; or the store will appear empty next run.
                            :store {:backend :file
                                    :path "sessions/proximum"
                                    :id #uuid "465df026-fcd3-4cb3-be44-29a929776250"}
                            :capacity 10000
                            :M 16
                            :ef-construction 200
                            :ef-search 50
                            :distance :euclidean
                            ;; Set true to fsync after every message.
                            :sync-on-write? false}
 :lateralus/memory-plugin  {:backend  #ig/ref :lateralus/memory-backend
                            :embedder #ig/ref :lateralus/embedder
                            :top-y    3
                            :last-n   5}
 :lateralus/file-tools           {}
 :lateralus/self-awareness-tools {}
 :lateralus/clojure-tools        {}
 ;; :mojeek is opt-in; default is :none for an air-gapped start.
 :lateralus/web-tools      {:provider :none}
 :lateralus/runtime-tools        {:enabled? true :network? true}
 :lateralus/loop-opts            {:max-tool-calls-per-turn 100 :max-tool-calls-per-exchange 20 :tool-content-caps {"clojure/eval" 12000 "clojure/add-lib" 12000}}
 :lateralus/tool-registry        [#ig/ref :lateralus/file-tools
                                  #ig/ref :lateralus/self-awareness-tools
                                  #ig/ref :lateralus/clojure-tools
                                  #ig/ref :lateralus/web-tools
                                  #ig/ref :lateralus/runtime-tools]
 :lateralus/tools-plugin         {:registry #ig/ref :lateralus/tool-registry}
 :lateralus/plugins              [#ig/ref :lateralus/memory-plugin
                                  #ig/ref :lateralus/tools-plugin]
 :lateralus/agent                {:plugins        #ig/ref :lateralus/plugins
                                  :llm-client     #ig/ref :lateralus/llm-client
                                  :llm-config     #ig/ref :lateralus/llm-config
                                  :embedder       #ig/ref :lateralus/embedder
                                  :memory-backend #ig/ref :lateralus/memory-backend
                                  :loop-opts        #ig/ref :lateralus/loop-opts}}
